# Copy to .env and fill in. Never commit .env.

# Claude API key. Create one at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Public LLM APIs, used with --extractor gemini, groq or openrouter.
# Free tiers may use what they receive, so do not send real invoices to them.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Replaces the default model of the providers above.
# NF_EXTRACTOR_LLM_MODEL=

# Any other chat completions API, used with --extractor custom.
# NF_EXTRACTOR_LLM_BASE_URL=
# NF_EXTRACTOR_LLM_API_KEY=

# Optional overrides (defaults shown).
# NF_EXTRACTOR_MODEL=claude-opus-5-5
# NF_EXTRACTOR_EFFORT=high
# NF_EXTRACTOR_MAX_TOKENS=16000
